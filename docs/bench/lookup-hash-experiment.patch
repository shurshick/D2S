 }
 
+/* ASCII folding matches name_eq exactly; no allocation or domain normalization. */
+static uint32_t name_hash(const uint8_t *name,size_t len) {
+    uint32_t h=2166136261u;
+    for(size_t i=0;i<len;i++) {
+        uint8_t c=name[i];if(c>='A' && c<='Z')c=(uint8_t)(c-'A'+'a');
+        h=(h^c)*16777619u;
+    }
+    return h;
+}
