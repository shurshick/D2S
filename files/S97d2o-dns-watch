#!/bin/sh
set -eu
umask 077
PATH=/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH
. /opt/d2k/d2k-lan.sh
BIN=/opt/sbin/d2o-dns-watch
PID=/opt/d2k/run/d2o-dns-watch.pid
IFACES=/opt/d2k/run/d2o-dns-watch.interfaces
OUTPUT=/tmp/d2k/whatsapp-media-observed.txt
running() {
    [ -r "$PID" ] || return 1
    pid=$(cat "$PID")
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = d2o-dns-watch ]
}
stop() {
    if running; then
        start-stop-daemon -K -q -p "$PID"
        for attempt in 1 2 3; do running || break; sleep 1; done
        running && return 1
    fi
    rm -f "$PID" "$IFACES"
    return 0
}
start() {
    entries=$(d2k_lan_ifaces) || { stop; return 1; }
    interfaces=$(printf '%s\n' "$entries" | tr '\n' ',' | sed 's/,$//')
    [ -n "$interfaces" ] || return 1
    if running; then
        [ "$(cat "$IFACES" 2>/dev/null)" != "$interfaces" ] || return 0
        stop
    fi
    mkdir -p /tmp/d2k /opt/d2k/run /opt/d2k/log
    chmod 0700 /tmp/d2k
    start-stop-daemon -S -b -m -p "$PID" -x "$BIN" -- --interfaces "$interfaces" --output "$OUTPUT" >> /opt/d2k/log/dns-watch.log 2>&1
    printf '%s\n' "$interfaces" > "$IFACES"
    sleep 1
    running
}
case "${1:-}" in
    start|refresh) start;;
    stop) stop;;
    restart) stop; start;;
    status) running && echo 'LAN DNS media observer running' || { echo 'LAN DNS media observer stopped'; exit 1; };;
    *) echo 'usage: start|stop|restart|refresh|status' >&2; exit 2;;
esac
