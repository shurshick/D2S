[Unit]
Description=D2S per-install enrollment
After=network-online.target

[Service]
User=nobody
Group=nogroup
LoadCredential=bootstrap:/etc/d2s-enroll/bootstrap.key
ExecStart=/usr/local/bin/d2s-enroll --bootstrap-file ${CREDENTIALS_DIRECTORY}/bootstrap
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=128M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
